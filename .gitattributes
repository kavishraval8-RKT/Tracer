# Normalise line endings so a Windows and a macOS/Linux tester don't hand each
# other diffs where every line changed. Text is stored LF in the repository and
# checked out native.
* text=auto

# KiCad's own formats are text and should diff cleanly.
*.kicad_sch text
*.kicad_pro text
*.kicad_sym text
*.kicad_pcb text

# Never touch these.
*.png binary
*.zip binary
*.pyc binary
