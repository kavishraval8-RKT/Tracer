# Copy this file to `.env` and paste in your own key.
#
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows
#
# `.env` is gitignored and must never be committed. A real GEMINI_API_KEY
# environment variable always wins over this file, so you can still override
# it per shell.
#
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Once you have pasted your key in, confirm it works:
#
#     python agent.py --check-key
#
# It reports which file or variable the key came from, then spends one small
# request checking that Gemini actually accepts it.


# --- everything below is NOT read from this file ----------------------------
#
# Only GEMINI_API_KEY is loaded from .env, by agent.py. The settings below are
# read from the real process environment, so putting them in here does
# nothing -- they are listed for reference, with the command to set each one.
#
# The plugin is the reason it works this way: once tracer_plugin has been
# copied into KiCad's plugin folder it is nowhere near this repository, so it
# cannot find this file until it already knows where the engine is. That is
# exactly what TRACER_HOME tells it, so TRACER_HOME cannot live here.
#
# None of these are needed by default.

# Where agent.py, app.py and generator.py live. Required once you have copied
# tracer_plugin into KiCad's own plugin folder; running the plugin from a
# checkout needs it not at all, because find_agent() walks up from
# tracer_plugin/ and finds agent.py beside it.
#
#   Windows:  [Environment]::SetEnvironmentVariable('TRACER_HOME','C:\path\to\tracer-engine','User')
#   POSIX:    export TRACER_HOME=/path/to/tracer-engine

# Force a specific interpreter for the agent subprocess. By default the plugin
# probes for one that can import the Gemini SDK. Set this if the probe picks
# the wrong Python.
#
#   Windows:  [Environment]::SetEnvironmentVariable('TRACER_PYTHON','C:\Python312\python.exe','User')
#   POSIX:    export TRACER_PYTHON=/usr/bin/python3

# Where the backend writes generated schematics. Defaults to ./generated
#
#   export TRACER_OUTPUT_DIR=/path/to/output

# Path to kicad-cli, for the optional ERC pass. Found automatically from PATH
# and the standard install locations, so set it only for an unusual install.
#
#   export KICAD_CLI=/path/to/kicad-cli
