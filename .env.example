# Copy this file to `.env` and fill in your own key.
#
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows
#
# `.env` is gitignored and must never be committed. A real environment
# variable always wins over this file, so you can override it per shell.
#
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- optional ---------------------------------------------------------------
# Only needed when the defaults do not fit your machine. agent.py and the
# plugin work without any of these.

# Where agent.py, app.py and generator.py live. The plugin finds them by
# walking up from tracer_plugin/, so this is only required once you have
# copied tracer_plugin into KiCad's own plugin folder, away from the engine.
# TRACER_HOME=/path/to/tracer-engine

# Force a specific interpreter for the agent subprocess. By default the plugin
# probes for one that can import the Gemini SDK. Set this if the probe picks
# the wrong Python.
# TRACER_PYTHON=/path/to/python

# Where the backend writes generated schematics. Defaults to ./generated
# TRACER_OUTPUT_DIR=/path/to/output

# Path to kicad-cli, used for the optional ERC pass. Found automatically from
# PATH and the standard install locations.
# KICAD_CLI=/path/to/kicad-cli
