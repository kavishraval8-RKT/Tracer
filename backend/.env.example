# Copy to backend/.env and fill in. Never commit real values.

# HS256 secret — MUST match tracer-frontend/.env.local's TRACER_DEVICE_JWT_SECRET.
# The frontend mints JWTs with it; the backend verifies with the same value.
TRACER_DEVICE_JWT_SECRET=

# Supabase — Project Settings → API.
# The URL is public (same as NEXT_PUBLIC_SUPABASE_URL on the frontend).
TRACER_SUPABASE_URL=
# SERVICE ROLE key — server-only, bypasses RLS. Same value as the frontend's
# SUPABASE_SERVICE_ROLE_KEY. Never expose to the client / plugin.
TRACER_SUPABASE_SERVICE_ROLE_KEY=

# Gemini upstream. Every LLM call uses this one key. Users never see it.
TRACER_GEMINI_API_KEY=
